# Postgres bağlantı adresi. Yerelde npm run db:start ile açılan portable
# Postgres'i, production'da ise Neon/Supabase gibi barındırılan bir Postgres'i
# gösterir. Neon kullanıyorsanız connection string genelde
# "...?sslmode=require" ile biter.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth (Auth.js) oturum imzalama anahtarı. `openssl rand -base64 33` ile
# üretilebilir. Yerel ve production'da FARKLI değerler kullanın.
AUTH_SECRET=""

# Production domain'iniz (örn. https://mapos.sirketiniz.com). Yerelde gerekli
# değildir.
NEXTAUTH_URL=""

# Dış sistemlerin /api/businesses üzerinden işletme kaydı yapabilmesi için
# kullanılan API anahtarı. x-api-key header'ı veya
# "Authorization: Bearer <anahtar>" ile gönderilir.
API_KEY=""
