{
  "name": "mapos-bayi-rotasi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:start": "../.postgres-runtime/Contents/Versions/16/bin/pg_ctl -D ../.postgres-runtime/data -l ../.postgres-runtime/logfile -o \"-p 5432 -k $(pwd)/../.postgres-runtime/sockets -h localhost\" start",
    "db:stop": "../.postgres-runtime/Contents/Versions/16/bin/pg_ctl -D ../.postgres-runtime/data stop",
    "db:status": "../.postgres-runtime/Contents/Versions/16/bin/pg_ctl -D ../.postgres-runtime/data status",
    "db:seed": "prisma db seed",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:create-admin": "tsx prisma/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
